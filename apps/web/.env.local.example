# Copy this file to .env.local and fill in real values there.
# .env.local is listed in the repo's .gitignore — never commit real secrets.
# See docs/ARCHITECTURE.md § "Where secrets live" at the repo root.

# Public: safe to ship to the browser (Next.js exposes anything prefixed
# NEXT_PUBLIC_ to client-side code). The anon key is meant to be public —
# it is only ever as safe as the Row Level Security policies behind it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_. Used only inside
# app/api/*/route.ts and other server-side code, never in a client component.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
META_WHATSAPP_TOKEN=
ANTHROPIC_API_KEY=
